# Copy to .env for local development. Never commit real values.
ALLOWED_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-to-a-long-random-string

# Optional: cookies.txt contents for yt-dlp when platforms block the server
YTDLP_COOKIES=

# Limits
MAX_DOWNLOAD_MB=200
MAX_CONVERT_MB=150
REQUEST_TIMEOUT=20
RATE_LIMIT_DEFAULT=120 per hour
RATE_LIMIT_DOWNLOAD=30 per hour
